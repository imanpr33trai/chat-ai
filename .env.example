# ─── Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values

# Backend proxy URL (handles auth for chat/models endpoints)
EXPO_PUBLIC_API_URL=http://localhost:3000

# NVIDIA NIM API key (for image/video generation endpoints)
NVIDIA_API_KEY=***

# Debug logging for NVIDIA API calls
DEBUG_NVIDIA=false
